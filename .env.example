# ---------------------------------------------------------------------------
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Postgres (Neon). DIRECT_URL bypasses the pooler for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Stripe. Use test keys (sk_test_…) until a charity entity is registered.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen` locally, or the dashboard endpoint in deployed envs.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ReliefWeb requires a pre-approved appname since 1 Nov 2025.
# Request one: https://apidoc.reliefweb.int/  (free, no token)
RELIEFWEB_APPNAME=""

# Protects /api/cron/ingest. Any long random string; set the same value in
# Vercel project settings so Vercel Cron can authenticate.
CRON_SECRET=""

# Transactional email for receipts.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="receipts@example.org"

# Admin auth (better-auth). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Receipt/audit document storage.
BLOB_READ_WRITE_TOKEN=""

# Rate limiting on donation endpoints.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Absolute site URL, used for OG images, receipt links and Stripe redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Connection pool size. Leave unset (defaults to 10) for real Postgres.
# Set to 1 when using `npx prisma dev`, whose PGlite server accepts only one
# connection at a time.
DATABASE_POOL_MAX=""
